# Optional local settings. Prefix npm start with these variables or export them.
PORT=3000
QUIZ_BIND=0.0.0.0
# QUIZ_DATA_DIR=/absolute/path/to/quiz-data
# Override auto-detected LAN origin if you have multiple network interfaces.
# QUIZ_PUBLIC_ORIGIN=http://192.168.1.25:3000
# Optional first-setup code, at least 12 characters. No default credentials.
# QUIZ_HOST_PASSWORD=replace-with-your-own-private-access-code
